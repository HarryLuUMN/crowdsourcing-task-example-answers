{
  "data": {
    "url": "/sales-data.json"
  },
  "title": "Sales over time",
  "transform": [
    {
      "filter": {
        "field": "category",
        "oneOf": [
          "Books",
          "Games"
        ]
      }
    }
  ],
  "mark": "line",
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month"
    },
    "y": {
      "field": "sales",
      "type": "quantitative",
      "title": "Sales"
    },
    "color": {
      "field": "category",
      "type": "nominal"
    }
  }
}
